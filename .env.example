# =============================================================================
# Demos configuration. Copy to .env and fill in what you need.
# NEVER commit .env. NEVER put your main wallet's key here.
# =============================================================================

# ---- Website (read by Vite at build time; VITE_ values end up in the public site) ----

# The deployed VotingDApp on Sepolia. `npm run deploy:sepolia` writes these into
# src/config/deployment.json automatically, so you only need them if you deployed
# from the browser or with Remix.
VITE_CONTRACT_ADDRESS=
VITE_DEPLOYMENT_BLOCK=

# Public Sepolia RPC endpoints used for reading, comma-separated, tried in order.
# Leave empty for the defaults (publicnode, drpc, 1rpc).
VITE_SEPOLIA_RPC_URL=

# Faucet shown when a wallet lacks gas money.
VITE_SEPOLIA_FAUCET_URL=https://cloud.google.com/application/web3/faucet/ethereum/sepolia
VITE_SEPOLIA_FAUCET_NAME=Google Cloud Web3 faucet
# Optional second faucet, shown as a fallback link.
VITE_SEPOLIA_FAUCET_BACKUP_URL=
VITE_SEPOLIA_FAUCET_BACKUP_NAME=

# Live-update interval and eth_getLogs range (rarely need changing).
VITE_POLL_INTERVAL_MS=12000
VITE_LOG_CHUNK_SIZE=10000

# ---- Hardhat (only used by the blockchain/ scripts; never sent to the browser) ----

# RPC used to deploy and verify. Public endpoint works; an Alchemy/Infura/Google
# Cloud Blockchain RPC URL is more reliable.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of a THROWAWAY deployer wallet that holds only Sepolia test ETH.
# Only needed for `npm run deploy:sepolia`. You can instead deploy from the
# website's Contract page with MetaMask and leave this empty.
DEPLOYER_PRIVATE_KEY=

# Free key from https://etherscan.io/myapikey, for `npm run verify:sepolia`.
ETHERSCAN_API_KEY=

# Create the sample "Which technology..." poll right after deploying (true/false).
SEED_SAMPLE_POLL=true
